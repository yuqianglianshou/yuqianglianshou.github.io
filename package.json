{
  "name": "yuqianglianshou.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "劉清揚的个人站：技术笔记与生活随笔。",
  "scripts": {
    "build": "npm run styles:build && bundle exec jekyll build",
    "serve": "npm run styles:build && bundle exec jekyll serve --livereload",
    "lint": "eslint \"js/**/*.js\"",
    "format": "prettier --write \"**/*.{html,md,css,scss,js,json,yml}\" --ignore-path .gitignore",
    "styles:build": "sass src/styles/main.scss css/main.css --style=expanded --no-source-map",
    "styles:check": "node scripts/check-generated-css.mjs",
    "styles:watch": "sass --watch src/styles/main.scss:css/main.css --style=expanded --no-source-map",
    "test": "node scripts/check-links.mjs",
    "check": "npm run lint && npm run styles:check && bundle exec jekyll build && npm run test"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuqianglianshou/yuqianglianshou.github.io.git"
  },
  "keywords": [],
  "author": "yuqianglianshou",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/yuqianglianshou/yuqianglianshou.github.io/issues"
  },
  "homepage": "https://github.com/yuqianglianshou/yuqianglianshou.github.io#readme",
  "devDependencies": {
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "sass": "^1.89.0"
  }
}
